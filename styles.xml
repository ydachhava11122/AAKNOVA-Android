<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/aaknova_navy_950</item>
        <item name="colorPrimaryDark">@color/aaknova_obsidian</item>
        <item name="colorAccent">@color/aaknova_gold</item>
        <item name="android:statusBarColor">@color/aaknova_navy_950</item>
        <item name="android:navigationBarColor">@color/aaknova_obsidian</item>
        <item name="android:windowBackground">@color/aaknova_navy_950</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aaknova_navy_950</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
